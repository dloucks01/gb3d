diff --git a/src/import/RomImporter.lua b/src/import/RomImporter.lua
index d950176..2868321 100644
--- a/src/import/RomImporter.lua
+++ b/src/import/RomImporter.lua
@@ -1953,10 +1953,44 @@ function RomImporter:_pollPickedFiles(dt)
   end
 end
 
+-- Web (love.js) has neither the native picker nor working drag-drop, so the
+-- HTML shell writes the chosen ROM into the LÖVE save directory as
+-- picked_rom.gb and this poll routes it through the same verified import path
+-- (startData) that a desktop drag-drop uses. Kept separate from the
+-- Android/iOS pickPending/focus flow so it inherits none of the SAF, delete,
+-- or export side effects that require self.android.
+function RomImporter:_pollWebRom(dt)
+  if self.workState == "working" then return end
+  if self._webOS == nil then
+    self._webOS = love.system.getOS() or "?"
+  end
+  if self._webOS ~= "Web" then return end
+  self._webTimer = (self._webTimer or 0) + dt
+  if self._webTimer < 0.3 then return end
+  self._webTimer = 0
+  -- The HTML shell writes the chosen ROM to this fixed absolute path in the
+  -- emscripten filesystem. We read it with Lua's io (the same libc FS view the
+  -- browser wrote through) rather than love.filesystem: PhysFS caches the save
+  -- directory listing and never sees a file created out-of-band, so getInfo
+  -- there would always miss it. io.open/os.remove hit the real FS directly.
+  local path = "/home/web_user/gen1_romdrop.gb"
+  local f = io.open(path, "rb")
+  if not f then return end
+  local data = f:read("*a")
+  f:close()
+  os.remove(path)
+  if type(data) == "string" and #data > 0 then
+    self:startData(data, "picked_rom.gb")
+  else
+    self:setError("The chosen ROM could not be read.")
+  end
+end
+
 function RomImporter:update(dt)
   self.pulse = self.pulse + dt
   self:_updatePadCursor(dt)
   self:_stepBaseRomScan()
+  self:_pollWebRom(dt)
   -- Pump the FlexLove view (input polling + the queued click actions).  The
   -- flag is only set once draw() has built a tree, so headless runs and the
   -- test tier never touch the toolkit.
