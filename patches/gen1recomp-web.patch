diff --git a/src/compat/luabit.lua b/src/compat/luabit.lua
new file mode 100644
index 0000000..11aef67
--- /dev/null
+++ b/src/compat/luabit.lua
@@ -0,0 +1,133 @@
+-- Pure-Lua reimplementation of the LuaJIT `bit` library (LuaBitOp API), used
+-- only on the love.js / emscripten Web build, whose Lua 5.1 core ships neither
+-- LuaJIT's `bit` module nor Lua 5.3 bitwise operators. The engine's ROM
+-- extractor, save converter and audio synth all `require("bit")`; main.lua
+-- registers this table as package.loaded["bit"] on Web before any of them load.
+--
+-- Semantics match LuaBitOp: every operand is taken modulo 2^32 and every result
+-- is returned as a SIGNED 32-bit number (bit 31 set => negative), so results
+-- are identical to the native library the desktop/mobile builds use. Doubles
+-- represent 32-bit integers exactly, so the arithmetic below is exact.
+--
+-- Performance: band/bor/bxor sit on a hot path -- the audio synth calls them
+-- per sample. Instead of looping over 32 bits per call, precompute 256x256 byte
+-- result tables once at load and combine the four bytes of each operand with a
+-- handful of lookups: exact, and several times faster than a per-bit loop.
+
+local floor = math.floor
+
+local TWO32 = 4294967296     -- 2^32
+local TWO31 = 2147483648     -- 2^31
+
+-- Operand -> unsigned 32-bit [0, 2^32)
+local function u32(x)
+  x = x % TWO32
+  if x < 0 then x = x + TWO32 end
+  return x
+end
+
+-- Unsigned 32-bit -> signed 32-bit result (LuaBitOp returns signed)
+local function tosigned(x)
+  if x >= TWO31 then return x - TWO32 end
+  return x
+end
+
+-- Byte result tables: AND[a][b], OR[a][b], XOR[a][b] for a,b in 0..255. Built
+-- once with a per-bit inner loop -- this runs a single time at load, never on
+-- the hot path.
+local AND, OR, XOR = {}, {}, {}
+for a = 0, 255 do
+  local ta, to, tx = {}, {}, {}
+  for b = 0, 255 do
+    local rand, ror, rxor, p = 0, 0, 0, 1
+    local aa, bb = a, b
+    for _ = 1, 8 do
+      local abit, bbit = aa % 2, bb % 2
+      if abit == 1 and bbit == 1 then rand = rand + p end
+      if abit == 1 or  bbit == 1 then ror  = ror  + p end
+      if abit ~= bbit             then rxor = rxor + p end
+      aa = (aa - abit) / 2
+      bb = (bb - bbit) / 2
+      p = p * 2
+    end
+    ta[b] = rand; to[b] = ror; tx[b] = rxor
+  end
+  AND[a] = ta; OR[a] = to; XOR[a] = tx
+end
+
+-- Combine two operands byte-by-byte through one of the tables above.
+local function bytewise(a, b, T)
+  a = u32(a); b = u32(b)
+  local a0 = a % 256; a = (a - a0) / 256
+  local a1 = a % 256; a = (a - a1) / 256
+  local a2 = a % 256; local a3 = (a - a2) / 256
+  local b0 = b % 256; b = (b - b0) / 256
+  local b1 = b % 256; b = (b - b1) / 256
+  local b2 = b % 256; local b3 = (b - b2) / 256
+  return T[a0][b0]
+       + T[a1][b1] * 256
+       + T[a2][b2] * 65536
+       + T[a3][b3] * 16777216
+end
+
+local bit = {}
+
+-- band/bor/bxor accept two or more operands, folding left, like LuaBitOp.
+function bit.band(a, b, ...)
+  local r = bytewise(a, b, AND)
+  for i = 1, select("#", ...) do r = bytewise(r, (select(i, ...)), AND) end
+  return tosigned(r)
+end
+
+function bit.bor(a, b, ...)
+  local r = bytewise(a, b, OR)
+  for i = 1, select("#", ...) do r = bytewise(r, (select(i, ...)), OR) end
+  return tosigned(r)
+end
+
+function bit.bxor(a, b, ...)
+  local r = bytewise(a, b, XOR)
+  for i = 1, select("#", ...) do r = bytewise(r, (select(i, ...)), XOR) end
+  return tosigned(r)
+end
+
+-- ~a over 32 bits is (2^32 - 1) - a.
+function bit.bnot(a)
+  return tosigned(4294967295 - u32(a))
+end
+
+-- Shift counts are taken mod 32 (LuaBitOp masks with 31).
+function bit.lshift(a, n)
+  n = n % 32
+  return tosigned((u32(a) * (2 ^ n)) % TWO32)
+end
+
+-- Logical (unsigned) right shift.
+function bit.rshift(a, n)
+  n = n % 32
+  return tosigned(floor(u32(a) / (2 ^ n)))
+end
+
+-- Arithmetic (sign-propagating) right shift.
+function bit.arshift(a, n)
+  n = n % 32
+  local x = u32(a)
+  local r = floor(x / (2 ^ n))
+  if n > 0 and x >= TWO31 then
+    -- Fill the vacated top n bits with ones.
+    r = r + (TWO32 - (2 ^ (32 - n)))
+  end
+  return tosigned(r)
+end
+
+-- tobit: normalize any number to a signed 32-bit int (handy, and cheap to add).
+function bit.tobit(a)
+  return tosigned(u32(a))
+end
+
+-- tohex: 8-lowercase-nibble hex of the low 32 bits, matching LuaBitOp default.
+function bit.tohex(a)
+  return string.format("%08x", u32(a))
+end
+
+return bit
